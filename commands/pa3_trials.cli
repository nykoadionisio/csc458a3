sh echo "=== TRIAL runs/reno-buffer60-run1 (limit 60, cport 5301) ==="
r tc qdisc replace dev r-right root handle 10: netem delay 5ms rate 10mbit limit 60
s ip tcp_metrics flush all
d ip tcp_metrics flush all
record runs/reno-buffer60-run1 40 reno 60 5301
s iperf3 -s -1 -B 10.0.1.1 -p 5201 -J > runs/reno-buffer60-run1/server.json 2> runs/reno-buffer60-run1/server.err &
sh sleep 1
d iperf3 -4 -c 10.0.1.1 -B 10.0.2.2 -p 5201 --cport 5301 -R -C reno -M 960 -t 40 -i 1 -J --get-server-output > runs/reno-buffer60-run1/client.json 2> runs/reno-buffer60-run1/client.err
waitrecord
plot runs/reno-buffer60-run1
