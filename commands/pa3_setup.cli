py net.addHost('s', ip=None)
py net.addHost('r', ip=None)
py net.addHost('d', ip=None)
py net.addLink(net['s'], net['r'], intfName1='s-data', intfName2='r-left')
py net.addLink(net['r'], net['d'], intfName1='r-right', intfName2='d-data')
py net.build()
py net.start()
