d sysctl -w net.ipv4.tcp_timestamps=0 net.ipv4.tcp_ecn=0 net.ipv4.tcp_no_metrics_save=1

s ethtool -k s-data

r ethtool -k r-right

d ethtool -k d-data

r sysctl net.ipv4.ip_forward

r sysctl net.ipv4.conf.r-right.rp_filter

